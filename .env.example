# CRYPTO MINING GAME — .env.example
# Copiar a .env y rellenar los valores reales. NUNCA subir el .env a git.
# Los valores de aquí son EJEMPLOS de desarrollo, no secretos reales.

# --- Base de datos ---
# PostgreSQL en producción (docker-compose). En local el backend puede usar
# SQLite como fallback si DATABASE_URL apunta a sqlite:///./app.db
DATABASE_URL=postgresql://cryptomining:cryptomining_dev_password@localhost:5432/crypto_mining_game
POSTGRES_USER=cryptomining
POSTGRES_PASSWORD=cryptomining_dev_password
POSTGRES_DB=crypto_mining_game

# --- Seguridad / backend ---
# Clave secreta para firmar JWT. En producción: cadena larga y aleatoria.
SECRET_KEY=cambiar_esta_clave_secreta_en_produccion
# Credenciales del administrador inicial (se crean al arrancar el backend)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar_la_clave_del_admin
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# development | production
ENVIRONMENT=development

# --- Depósitos USDT (BSC BEP-20) ---
# Dirección de depósito: la USDT de AMO (misma que usa en Dragon Land;
# dirección EVM, sirve igual en BSC para recibir USDT BEP-20). El escáner
# automático vigila esta dirección cuando BSCSCAN_API_KEY esté configurada.
# UNA SOLA dirección (AMO, 2026-11-17): no hay dirección TRON.
DEPOSIT_BSC_ADDRESS=0x71457a5a883ae25b21fdf2cc8784201d56e8bc2d
# Clave de API para verificar depósitos on-chain (opcional; sin ella la
# verificación es manual por el admin). VACÍA hasta que el admin la cree.
BSCSCAN_API_KEY=

# --- Frontend ---
# URL pública de la API que usará el frontend
VITE_API_URL=http://localhost:8000
# Project ID de WalletConnect (opcional; vacío hasta que el admin lo cree)
VITE_WALLETCONNECT_PROJECT_ID=
