# Copiar a .env y rellenar. NUNCA commitear el .env real.
DATABASE_URL=sqlite:///./data/mining.db
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-password-admin
# Direcciones de deposito
# BSC (BEP-20): direccion USDT de AMO (misma que usa en Dragon Land; es una
# direccion EVM y sirve igual en BSC para recibir USDT BEP-20). El escaner
# automatico vigila esta direccion cuando BSCSCAN_API_KEY este configurada.
# UNA SOLA direccion (AMO, 2026-11-17): no hay direccion TRON.
DEPOSIT_BSC_ADDRESS=0x71457a5a883ae25b21fdf2cc8784201d56e8bc2d
# Claves de verificacion on-chain (opcionales; sin ellas los depositos quedan pendientes)
BSCSCAN_API_KEY=
